<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Repas.Domaine\Repas.Domaine.csproj" />
    <ProjectReference Include="..\Repas.Donnees\Repas.Donnees.csproj" />
  </ItemGroup>

  <!-- Les scripts de db/migrations suivent l'app (bin et publication) ; l'exécuteur les lit au démarrage. -->
  <ItemGroup>
    <Content Include="..\..\db\migrations\*" Link="db\migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
