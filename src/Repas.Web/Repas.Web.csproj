<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Repas.Domaine\Repas.Domaine.csproj" />
    <ProjectReference Include="..\Repas.Donnees\Repas.Donnees.csproj" />
  </ItemGroup>

  <!-- Les scripts de db/migrations et db/seed suivent l'app (bin et publication) ; l'exécuteur les lit au démarrage. -->
  <ItemGroup>
    <Content Include="..\..\db\migrations\*.sql" Link="db\migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\db\seed\*.sql" Link="db\seed\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Le script de Blazor (_framework/blazor.web.js) vient d'un paquet que le SDK n'ajoute que s'il voit des
         fichiers .razor. Le Dockerfile restaure les paquets avec les seuls .csproj (pour le cache) : sans cette
         ligne, l'image publiée n'a pas le script et aucune page n'est interactive. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

</Project>
