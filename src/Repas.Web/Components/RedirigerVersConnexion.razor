@* Affiché quand une page interactive constate que la personne n'est plus connectée
   (compte désactivé pendant la session). Recharge vers la page de connexion. *@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var retour = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"connexion?retour={Uri.EscapeDataString(retour)}", forceLoad: true);
    }
}
