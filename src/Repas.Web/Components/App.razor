<!DOCTYPE html>
<html lang="fr-CA">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Repas.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModeRendu" />
</head>

<body>
    <Routes @rendermode="ModeRendu" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Interactif partout, sauf sur les pages marquées [ExcludeFromInteractiveRouting] (la connexion).
    private IComponentRenderMode? ModeRendu =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
