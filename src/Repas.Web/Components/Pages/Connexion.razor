@page "/connexion"
@* Page rendue côté serveur seulement : le cookie de connexion doit être posé dans une réponse HTTP,
   ce qui est impossible à travers le circuit interactif (SignalR). *@
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Http.HttpResults
@using Repas.Web.Authentification
@inject ServiceConnexion ServiceConnexion
@inject NavigationManager Navigation

<PageTitle>Connexion</PageTitle>

<section class="connexion">
    <h1>Connexion</h1>

    <EditForm Model="Saisie" method="post" OnValidSubmit="SeConnecterAsync" FormName="connexion">
        <DataAnnotationsValidator />

        @if (_erreur is not null)
        {
            <p class="message-erreur" role="alert">@_erreur</p>
        }

        <div class="champ">
            <label for="courriel">Courriel</label>
            <InputText id="courriel" type="email" @bind-Value="Saisie.Courriel" autocomplete="username" autofocus />
            <ValidationMessage For="() => Saisie.Courriel" />
        </div>

        <div class="champ">
            <label for="mot-de-passe">Mot de passe</label>
            <InputText id="mot-de-passe" type="password" @bind-Value="Saisie.MotDePasse" autocomplete="current-password" />
            <ValidationMessage For="() => Saisie.MotDePasse" />
        </div>

        <div class="champ-case">
            <InputCheckbox id="rester-connecte" @bind-Value="Saisie.ResterConnecte" />
            <label for="rester-connecte">Rester connecté</label>
        </div>

        <button type="submit" class="bouton-principal">Se connecter</button>
    </EditForm>
</section>

@code {
    private const string MessageEchec = "Courriel ou mot de passe invalide.";

    private string? _erreur;

    [SupplyParameterFromForm]
    private SaisieConnexion Saisie { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "retour")]
    private string? Retour { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string AdresseApresConnexion => RedirectHttpResult.IsLocalUrl(Retour) ? Retour! : "/";

    protected override void OnInitialized()
    {
        Saisie ??= new SaisieConnexion();

        // Déjà connecté : inutile de montrer le formulaire.
        if (HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(AdresseApresConnexion);
        }
    }

    private async Task SeConnecterAsync()
    {
        var utilisateur = await ServiceConnexion.VerifierAsync(Saisie.Courriel, Saisie.MotDePasse);
        if (utilisateur is null)
        {
            // Le mot de passe saisi n'est jamais renvoyé dans la page.
            Saisie.MotDePasse = string.Empty;
            _erreur = MessageEchec;
            return;
        }

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            ServiceConnexion.CreerPrincipal(utilisateur),
            // Persistant : le cookie survit à la fermeture du navigateur (30 jours, prolongés à l'usage).
            // Sinon, il disparaît avec la session du navigateur.
            new AuthenticationProperties { IsPersistent = Saisie.ResterConnecte });

        Navigation.NavigateTo(AdresseApresConnexion);
    }

    private sealed class SaisieConnexion
    {
        [Required(ErrorMessage = "Le courriel est requis.")]
        [StringLength(254, ErrorMessage = "Le courriel est trop long.")]
        public string Courriel { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le mot de passe est requis.")]
        [StringLength(200, ErrorMessage = "Le mot de passe est trop long.")]
        public string MotDePasse { get; set; } = string.Empty;

        public bool ResterConnecte { get; set; }
    }
}
