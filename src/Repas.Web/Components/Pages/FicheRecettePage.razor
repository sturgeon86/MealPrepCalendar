@page "/recettes/nouvelle"
@page "/recettes/{Id:int}/modifier"
@page "/recettes/importer"
@using Repas.Domaine.Import
@using Repas.Domaine.Mesures
@using Repas.Domaine.Recettes
@using Repas.Domaine.Referentiel
@using Repas.Donnees
@using Repas.Donnees.Photos
@using Repas.Donnees.Web
@using Repas.Web.Authentification
@using Repas.Web.Components.Recettes
@inject DepotRecettes DepotRecettes
@inject StockagePhotos StockagePhotos
@inject ILogger<FicheRecettePage> Journal
@inject DepotCategories DepotCategories
@inject DepotUnites DepotUnites
@inject DepotIngredients DepotIngredients
@inject TelechargementWeb TelechargementWeb
@inject NavigationManager Navigation

<PageTitle>@(_estImport ? "Importer une recette" : EstNouvelle ? "Nouvelle recette" : _nom.Length > 0 ? _nom : "Recette")</PageTitle>

<p><a href="@(EstNouvelle ? "recettes" : $"recettes/{Id}")">@(EstNouvelle ? "← Recettes" : "← Retour à la recette")</a></p>

@if (_introuvable)
{
    <h1>Recette introuvable</h1>
    <p>Cette recette n'existe pas ou plus.</p>
}
else if (!_charge)
{
    <p>Chargement…</p>
}
else if (_estImport && !_brouillonLu)
{
    <h1>Importer une recette</h1>

    @if (_erreurs.Count > 0)
    {
        <div class="message-erreur" role="alert">
            @foreach (var erreur in _erreurs)
            {
                <p>@erreur</p>
            }
        </div>
    }

    <section class="carte-formulaire carte-large">
        <h2>Depuis un site web</h2>
        <p class="aide">
            Collez l'adresse de la page de la recette. La plupart des sites de recettes (Ricardo, Coup de pouce,
            5 ingredients 15 minutes…) publient la recette dans un format que l'app sait lire, avec sa photo.
        </p>
        <div class="champ">
            <label for="adresse-recette">Adresse de la page</label>
            <input id="adresse-recette" type="url" inputmode="url" autocomplete="off" placeholder="https://…"
                   maxlength="@AdresseImport.LongueurMax" @bind="_adresseImport" @onkeyup="ImporterSiEntreeAsync" />
        </div>
        <div class="actions-page">
            <button type="button" class="bouton-principal bouton-compact" disabled="@_enCours" @onclick="ImporterPageAsync">
                @(_enCours ? "Lecture de la page…" : "Importer la page")
            </button>
        </div>
    </section>

    <section class="carte-formulaire carte-large import-texte">
        <h2>Ou coller le texte</h2>
        <p class="aide">
            Collez la recette : le titre sur la première ligne, puis un ingrédient par ligne et les étapes.
            Les intertitres « Ingrédients » et « Préparation » aident la lecture. Rien n'est enregistré avant
            que vous ayez vérifié la recette à l'étape suivante.
        </p>
        <div class="champ">
            <label for="texte-recette">Texte de la recette</label>
            <textarea id="texte-recette" @bind="_texteImport"
                      placeholder="@ExempleTexte"></textarea>
        </div>
        <div class="actions-page">
            <button type="button" class="bouton-principal bouton-compact" disabled="@_enCours" @onclick="LireTexteAsync">Lire la recette</button>
        </div>
    </section>
}
else
{
    <h1>@(_estImport ? "Vérifier la recette importée" : EstNouvelle ? "Nouvelle recette" : "Modifier la recette")</h1>

    @if (_estImport)
    {
        var aRapprocher = _lignes.Count(l => l.Statut is not null);
        <p class="aide">
            @if (aRapprocher > 0)
            {
                <strong>@aRapprocher @(aRapprocher > 1 ? "ingrédients sont" : "ingrédient est") à confirmer ou à choisir</strong>
                <text> (surlignés ci-dessous). </text>
            }
            Vérifiez aussi les quantités et les étapes, puis enregistrez.
            <button type="button" class="bouton-lien-texte" @onclick="() => _brouillonLu = false">Revenir à l'import</button>
        </p>
        @if (_sourceUrl is not null)
        {
            <p class="aide">Source : <a href="@_sourceUrl" target="_blank" rel="noopener noreferrer nofollow">@_sourceUrl</a></p>
        }
        @if (_avertissementImport is not null)
        {
            <p class="message-avertissement" role="status">@_avertissementImport</p>
        }
    }

    @if (_erreurs.Count > 0)
    {
        <div class="message-erreur" role="alert" tabindex="-1" @ref="_zoneErreurs">
            <ul>
                @foreach (var erreur in _erreurs)
                {
                    <li>@erreur</li>
                }
            </ul>
        </div>
    }

    <section class="carte-formulaire carte-large">
        <div class="champ">
            <label for="nom">Nom</label>
            <input id="nom" @bind="_nom" maxlength="@ValidationRecette.LongueurMaxNom" autocomplete="off" />
        </div>

        <div class="grille-3">
            <div class="champ">
                <label for="portions">Portions</label>
                <input id="portions" type="number" min="1" max="@ValidationRecette.PortionsMax" @bind="_portions" />
            </div>
            <div class="champ">
                <label for="preparation">Préparation (min)</label>
                <input id="preparation" type="number" min="0" @bind="_tempsPreparation" />
            </div>
            <div class="champ">
                <label for="cuisson">Cuisson (min)</label>
                <input id="cuisson" type="number" min="0" @bind="_tempsCuisson" />
            </div>
        </div>
    </section>

    <section class="carte-formulaire carte-large">
        <h2>Photo</h2>
        @if (SourcePhotoAffichee is { } source)
        {
            <img class="photo-recette" src="@source" alt="Photo de la recette" />
        }
        else
        {
            <p class="aide">Aucune photo. Sur un cellulaire, on peut aussi prendre la photo directement.</p>
        }

        @if (_erreurPhoto is not null)
        {
            <p class="message-erreur" role="alert">@_erreurPhoto</p>
        }

        <div class="actions-photo">
            @* Le champ de fichier est caché derrière une étiquette en forme de bouton ; @key le recrée après chaque choix
               pour qu'on puisse choisir de nouveau le même fichier. *@
            <InputFile @key="_cleChoixPhoto" id="photo" class="visuellement-cache" accept="image/*" OnChange="ChoisirPhotoAsync"
                       disabled="@_traitementPhoto" />
            <label for="photo" class="bouton-secondaire @(_traitementPhoto ? "desactive" : null)">
                @(_traitementPhoto ? "Préparation de la photo…" : SourcePhotoAffichee is null ? "Choisir une photo" : "Changer la photo")
            </label>
            @if (SourcePhotoAffichee is not null)
            {
                <button type="button" class="bouton-secondaire" disabled="@_traitementPhoto" @onclick="RetirerPhoto">Retirer la photo</button>
            }
        </div>
        @if (_nouvellePhoto is not null || (_photoRetiree && _photoChemin is not null))
        {
            <p class="aide">Le changement de photo sera conservé à l'enregistrement de la recette.</p>
        }
    </section>

    <section class="carte-formulaire carte-large">
        <h2>Ingrédients</h2>
        <p class="aide">Quantités comme dans la recette : 2, 2,5, 1/2, 1 1/2 ou ½. Laissez la quantité vide pour « au goût ».</p>

        @if (_lignes.Count > 0)
        {
            <ol class="lignes-recette">
                @for (var i = 0; i < _lignes.Count; i++)
                {
                    var ligne = _lignes[i];
                    var position = i;
                    <li @key="ligne.Cle" class="ligne-ingredient @(ligne.Statut is not null ? "ligne-a-rapprocher" : null)">
                        <span class="nom-ligne zone-nom">@ligne.NomIngredient</span>
                        <div class="zone-quantite">
                            <label class="visuellement-cache" for="quantite-@ligne.Cle">Quantité de @ligne.NomIngredient</label>
                            <input id="quantite-@ligne.Cle" placeholder="Qté" @bind="ligne.QuantiteTexte" autocomplete="off" inputmode="decimal" />
                        </div>
                        <div class="zone-unite">
                            <label class="visuellement-cache" for="unite-@ligne.Cle">Unité de @ligne.NomIngredient</label>
                            <select id="unite-@ligne.Cle" @bind="ligne.UniteId">
                                <option value="">—</option>
                                @foreach (var groupe in _unites.GroupBy(u => u.TypeMesure))
                                {
                                    <optgroup label="@LibelleType(groupe.Key)">
                                        @foreach (var unite in groupe)
                                        {
                                            <option value="@unite.Id">@unite.Code</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="zone-precision">
                            <label class="visuellement-cache" for="precision-@ligne.Cle">Précision pour @ligne.NomIngredient</label>
                            <input id="precision-@ligne.Cle" placeholder="Précision (ex. : haché)" @bind="ligne.Precision"
                                   maxlength="@ValidationRecette.LongueurMaxPrecision" autocomplete="off" />
                        </div>
                        <div class="zone-optionnel champ-case">
                            <input id="optionnel-@ligne.Cle" type="checkbox" @bind="ligne.EstOptionnel" />
                            <label for="optionnel-@ligne.Cle">Facultatif</label>
                        </div>
                        <span class="zone-actions actions-ligne">
                            <button type="button" class="bouton-icone" aria-label="Monter @ligne.NomIngredient" title="Monter"
                                    disabled="@(position == 0)" @onclick="() => Deplacer(_lignes, position, -1)">↑</button>
                            <button type="button" class="bouton-icone" aria-label="Descendre @ligne.NomIngredient" title="Descendre"
                                    disabled="@(position == _lignes.Count - 1)" @onclick="() => Deplacer(_lignes, position, 1)">↓</button>
                            <button type="button" class="bouton-icone" aria-label="Retirer @ligne.NomIngredient" title="Retirer"
                                    @onclick="() => RetirerLigne(position)">✕</button>
                        </span>
                        @if (ligne.TexteLu is not null)
                        {
                            @* Import : le texte lu, et l'ingrédient du référentiel à confirmer, à choisir ou à créer. *@
                            <div class="zone-rapprochement">
                                <span class="texte-lu">Lu : « @ligne.TexteLu »</span>
                                @if (_ligneEnChangement == ligne)
                                {
                                    @if (_nomACreer is null)
                                    {
                                        <RechercheIngredient IdChamp="changer-ingredient" Libelle="Chercher l'ingrédient"
                                                             AuChoix="i => ChoisirPourLigne(ligne, i.Id, i.Nom, i.UniteReference)"
                                                             AuCreer="CommencerCreation" />
                                        <button type="button" class="bouton-secondaire bouton-mini" @onclick="AnnulerChangement">Annuler</button>
                                    }
                                    else
                                    {
                                        <CreationRapideIngredient NomInitial="@_nomACreer" Categories="_categories" Unites="_unites"
                                                                  AuCreation="AjouterIngredientCree" AuAnnuler="AnnulerChangement" />
                                    }
                                }
                                else
                                {
                                    switch (ligne.Statut)
                                    {
                                        case StatutRapprochement.Approche:
                                            <span class="statut-rapprochement">Est-ce « @ligne.NomIngredient » ?</span>
                                            <button type="button" class="bouton-principal bouton-mini" @onclick="() => ligne.Statut = null">Oui</button>
                                            @foreach (var autre in ligne.Suggestions.Skip(1))
                                            {
                                                <button type="button" class="bouton-secondaire bouton-mini"
                                                        @onclick="() => ChoisirPourLigne(ligne, autre.IngredientId, autre.Nom, null)">@autre.Nom</button>
                                            }
                                            <button type="button" class="bouton-lien-texte" @onclick="() => Changer(ligne)">Autre…</button>
                                            break;
                                        case StatutRapprochement.Ambigu:
                                            <span class="statut-rapprochement">Lequel ?</span>
                                            @foreach (var suggestion in ligne.Suggestions)
                                            {
                                                <button type="button" class="bouton-secondaire bouton-mini"
                                                        @onclick="() => ChoisirPourLigne(ligne, suggestion.IngredientId, suggestion.Nom, null)">@suggestion.Nom</button>
                                            }
                                            <button type="button" class="bouton-lien-texte" @onclick="() => Changer(ligne)">Autre…</button>
                                            break;
                                        case StatutRapprochement.ACreer:
                                            <span class="statut-rapprochement">Absent du référentiel.</span>
                                            <button type="button" class="bouton-principal bouton-mini"
                                                    @onclick="() => CreerPourLigne(ligne)">Créer « @ligne.NomIngredient »</button>
                                            <button type="button" class="bouton-lien-texte" @onclick="() => Changer(ligne)">Chercher…</button>
                                            break;
                                        default:
                                            <span>✓</span>
                                            <button type="button" class="bouton-lien-texte" @onclick="() => Changer(ligne)">Changer l'ingrédient</button>
                                            break;
                                    }
                                }
                            </div>
                        }
                    </li>
                }
            </ol>
        }

        @if (_ligneEnChangement is not null)
        {
            @* Un seul ingrédient se cherche ou se crée à la fois : celui de la ligne en cours. *@
        }
        else if (_nomACreer is null)
        {
            <RechercheIngredient IdChamp="ajout-ingredient" AuChoix="AjouterIngredient" AuCreer="CommencerCreation" />
        }
        else
        {
            <CreationRapideIngredient NomInitial="@_nomACreer" Categories="_categories" Unites="_unites"
                                      AuCreation="AjouterIngredientCree" AuAnnuler="() => _nomACreer = null" />
        }
    </section>

    <section class="carte-formulaire carte-large">
        <h2>Étapes</h2>
        <ol class="lignes-recette">
            @for (var i = 0; i < _etapes.Count; i++)
            {
                var etape = _etapes[i];
                var position = i;
                <li @key="etape.Cle" class="ligne-etape">
                    <label class="visuellement-cache" for="etape-@etape.Cle">Étape @(position + 1)</label>
                    <span class="numero-etape" aria-hidden="true">@(position + 1).</span>
                    <textarea id="etape-@etape.Cle" rows="2" @bind="etape.Texte" maxlength="@ValidationRecette.LongueurMaxEtape"></textarea>
                    <span class="actions-ligne">
                        <button type="button" class="bouton-icone" aria-label="Monter l'étape @(position + 1)" title="Monter"
                                disabled="@(position == 0)" @onclick="() => Deplacer(_etapes, position, -1)">↑</button>
                        <button type="button" class="bouton-icone" aria-label="Descendre l'étape @(position + 1)" title="Descendre"
                                disabled="@(position == _etapes.Count - 1)" @onclick="() => Deplacer(_etapes, position, 1)">↓</button>
                        <button type="button" class="bouton-icone" aria-label="Retirer l'étape @(position + 1)" title="Retirer"
                                @onclick="() => _etapes.RemoveAt(position)">✕</button>
                    </span>
                </li>
            }
        </ol>
        <button type="button" class="bouton-secondaire" @onclick="() => _etapes.Add(new ModeleEtape())">+ Ajouter une étape</button>
    </section>

    <section class="carte-formulaire carte-large">
        <h2>Étiquettes et notes</h2>

        @if (_etiquettes.Count > 0)
        {
            <ul class="etiquettes" aria-label="Étiquettes de la recette">
                @foreach (var etiquette in _etiquettes)
                {
                    <li @key="etiquette">
                        @etiquette
                        <button type="button" class="retirer-etiquette" aria-label="Retirer l'étiquette @etiquette"
                                @onclick="() => _etiquettes.Remove(etiquette)">✕</button>
                    </li>
                }
            </ul>
        }

        <div class="champ">
            <label for="nouvelle-etiquette">Ajouter une étiquette</label>
            <div class="ajout-etiquette">
                <input id="nouvelle-etiquette" list="etiquettes-existantes" @bind="_nouvelleEtiquette" @bind:event="oninput"
                       @onkeyup="AjouterEtiquetteSiEntree" maxlength="@ValidationRecette.LongueurMaxEtiquette" autocomplete="off"
                       placeholder="Ex. : Végétarien, Souper rapide" />
                <button type="button" class="bouton-secondaire" @onclick="AjouterEtiquette">Ajouter</button>
            </div>
            <datalist id="etiquettes-existantes">
                @foreach (var existante in _etiquettesExistantes)
                {
                    <option value="@existante"></option>
                }
            </datalist>
        </div>

        <div class="champ">
            <label for="notes">Notes</label>
            <textarea id="notes" rows="3" @bind="_notes"></textarea>
        </div>
    </section>

    <div class="barre-enregistrer">
        <button type="button" class="bouton-principal" disabled="@_enCours" @onclick="EnregistrerAsync">Enregistrer la recette</button>
    </div>
}

@code {
    private bool _charge;
    private bool _introuvable;
    private bool _enCours;
    private List<string> _erreurs = [];
    private ElementReference _zoneErreurs;
    private bool _focusErreurs;

    private List<Categorie> _categories = [];
    private List<Unite> _unites = [];
    private List<string> _etiquettesExistantes = [];

    private string _nom = string.Empty;
    private int _portions = 4;
    private int? _tempsPreparation;
    private int? _tempsCuisson;
    private string? _notes;
    private SourceRecette _source = SourceRecette.Manuelle;
    private List<ModeleLigne> _lignes = [];
    private List<ModeleEtape> _etapes = [];
    private List<string> _etiquettes = [];
    private string _nouvelleEtiquette = string.Empty;
    private string? _nomACreer;

    // Import (story 8.3) : le texte collé, puis le brouillon à vérifier ; rien n'est enregistré avant « Enregistrer ».
    private bool _estImport;
    private bool _brouillonLu;
    private string _texteImport = string.Empty;
    private RapprochementIngredients? _rapprochement;
    private ModeleLigne? _ligneEnChangement;
    private string _adresseImport = string.Empty;
    private string? _avertissementImport;

    // L'adresse de la page d'où vient la recette (import web) ; gardée telle quelle à la modification.
    private string? _sourceUrl;

    private const string ExempleTexte =
        "Pâté chinois\nPortions : 6\n\nIngrédients\n1 lb de boeuf haché\n1 oignon, haché\n…\n\nPréparation\n1. Préchauffer le four…";

    // Photo : celle enregistrée, et le changement en attente (nouvelle photo ou retrait) jusqu'à l'enregistrement.
    private string? _photoChemin;
    private byte[]? _nouvellePhoto;
    private string? _apercuNouvellePhoto;
    private bool _photoRetiree;
    private bool _traitementPhoto;
    private string? _erreurPhoto;
    private Guid _cleChoixPhoto = Guid.NewGuid();

    /// <summary>Largeur de l'aperçu d'une photo pas encore enregistrée (plus léger à envoyer au navigateur).</summary>
    private const int LargeurApercu = 800;

    /// <summary>Filet de sécurité : au-delà, le navigateur n'arrivera pas à préparer la photo.</summary>
    private static readonly TimeSpan DelaiPreparation = TimeSpan.FromSeconds(30);

    [Parameter]
    public int? Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> EtatAuthentification { get; set; } = default!;

    private bool EstNouvelle => Id is null;

    private string? SourcePhotoAffichee =>
        _apercuNouvellePhoto ?? (_photoRetiree || _photoChemin is null ? null : $"photos/{_photoChemin}");

    /// <summary>La photo qui sera enregistrée avec la recette, si aucune nouvelle photo n'est choisie.</summary>
    private string? PhotoConservee => _photoRetiree ? null : _photoChemin;

    protected override async Task OnInitializedAsync()
    {
        _categories = await DepotCategories.ListerAsync();
        _unites = await DepotUnites.ListerAsync();
        _etiquettesExistantes = await DepotRecettes.ListerEtiquettesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _charge = false;
        _introuvable = false;
        _erreurs = [];
        _nomACreer = null;
        _ligneEnChangement = null;
        _estImport = Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("recettes/importer", StringComparison.OrdinalIgnoreCase);
        _brouillonLu = false;
        _avertissementImport = null;
        _sourceUrl = null;
        _photoChemin = null;
        _nouvellePhoto = null;
        _apercuNouvellePhoto = null;
        _photoRetiree = false;
        _erreurPhoto = null;

        if (EstNouvelle)
        {
            _nom = string.Empty;
            _portions = 4;
            _tempsPreparation = null;
            _tempsCuisson = null;
            _notes = null;
            _source = SourceRecette.Manuelle;
            _lignes = [];
            _etapes = [new ModeleEtape()];
            _etiquettes = [];
            _charge = true;
            return;
        }

        var recette = await DepotRecettes.TrouverAsync(Id!.Value);
        if (recette is null)
        {
            _introuvable = true;
            return;
        }

        _nom = recette.Nom;
        _portions = recette.Portions;
        _tempsPreparation = recette.TempsPreparationMin;
        _tempsCuisson = recette.TempsCuissonMin;
        _notes = recette.Notes;
        _source = recette.Source;
        _lignes = recette.Ingredients.Select(ModeleLigne.Depuis).ToList();
        _etapes = recette.Etapes.Select(t => new ModeleEtape { Texte = t }).ToList();
        _etiquettes = recette.Etiquettes.ToList();
        _photoChemin = recette.PhotoChemin;
        _sourceUrl = recette.SourceUrl;
        _charge = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Après un enregistrement refusé, amène les erreurs à l'écran (et aux lecteurs d'écran).
        if (_focusErreurs)
        {
            _focusErreurs = false;
            await _zoneErreurs.FocusAsync();
        }
    }

    private static string LibelleType(TypeMesure type) => type switch
    {
        TypeMesure.Poids => "Poids",
        TypeMesure.Volume => "Volume",
        _ => "À la pièce",
    };

    private void AjouterIngredient(ResumeIngredient ingredient)
    {
        // L'unité proposée est celle des totaux de l'ingrédient ; on peut la changer.
        var unite = _unites.FirstOrDefault(u => u.Code == ingredient.UniteReference);
        _lignes.Add(new ModeleLigne { IngredientId = ingredient.Id, NomIngredient = ingredient.Nom, UniteId = unite?.Id });
    }

    private void CommencerCreation(string nom) => _nomACreer = nom;

    private void AjouterIngredientCree(CreationRapideIngredient.IngredientCree cree)
    {
        _nomACreer = null;
        if (_ligneEnChangement is { } ligne)
        {
            _rapprochement = null; // Le référentiel a changé : il sera relu au prochain import.
            ChoisirPourLigne(ligne, cree.Id, cree.Nom, null, cree.UniteReferenceId);
            return;
        }

        _lignes.Add(new ModeleLigne { IngredientId = cree.Id, NomIngredient = cree.Nom, UniteId = cree.UniteReferenceId });
    }

    private async Task LireTexteAsync()
    {
        _erreurs = [];
        var brouillon = LectureTexteRecette.Lire(_texteImport);
        if (brouillon.Ingredients.Count == 0)
        {
            _erreurs = ["Aucun ingrédient n'a été trouvé. Mettez un ingrédient par ligne, sous un intertitre « Ingrédients » ou en commençant chaque ligne par sa quantité."];
            return;
        }

        _enCours = true;
        try
        {
            await AppliquerBrouillonAsync(brouillon);
        }
        finally
        {
            _enCours = false;
        }
    }

    private async Task ImporterSiEntreeAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_enCours)
        {
            await ImporterPageAsync();
        }
    }

    private async Task ImporterPageAsync()
    {
        _erreurs = [];
        if (AdresseImport.Valider(_adresseImport, out var adresse) is { } probleme)
        {
            _erreurs = [probleme];
            return;
        }

        _enCours = true;
        try
        {
            var page = await TelechargementWeb.LirePageAsync(adresse!);
            var brouillon = LectureRecetteWeb.Lire(page.Html, page.Adresse);
            if (brouillon is null || brouillon.Ingredients.Count == 0)
            {
                _erreurs = ["Cette page ne contient pas de données de recette que l'app sait lire. Copiez plutôt le texte de la recette dans « Ou coller le texte »."];
                return;
            }

            await AppliquerBrouillonAsync(brouillon);

            // La photo de la page devient celle de la recette ; sans elle, l'import continue.
            if (brouillon.PhotoUrl is { } photoUrl)
            {
                try
                {
                    var photo = await TelechargementWeb.LireImageAsync(new Uri(photoUrl));
                    var format = PhotoRecette.Verifier(photo);
                    _nouvellePhoto = photo;
                    _apercuNouvellePhoto = $"data:{PhotoRecette.TypeContenu(PhotoRecette.NouveauNom(format))};base64,{Convert.ToBase64String(photo)}";
                    _photoRetiree = false;
                }
                catch (Exception ex) when (ex is ImportWebException or PhotoInvalideException or UriFormatException)
                {
                    _avertissementImport = $"La photo de la page n'a pas pu être récupérée : {ex.Message} Vous pouvez en choisir une.";
                }
            }
        }
        catch (ImportWebException ex)
        {
            _erreurs = [ex.Message];
        }
        finally
        {
            _enCours = false;
        }
    }

    /// <summary>Remplit le formulaire avec le brouillon lu ; rien n'est enregistré.</summary>
    private async Task AppliquerBrouillonAsync(BrouillonRecette brouillon)
    {
        _rapprochement ??= new RapprochementIngredients(await DepotIngredients.ListerPourRapprochementAsync());
        _avertissementImport = null;
        _sourceUrl = brouillon.SourceUrl is { Length: <= AdresseImport.LongueurMax } source ? source : null;
        _nouvellePhoto = null;
        _apercuNouvellePhoto = null;

        _nom = brouillon.Nom.Length > ValidationRecette.LongueurMaxNom ? brouillon.Nom[..ValidationRecette.LongueurMaxNom] : brouillon.Nom;
        _portions = brouillon.Portions is { } portions and >= 1 and <= ValidationRecette.PortionsMax ? portions : 4;
        _tempsPreparation = brouillon.TempsPreparationMin;
        _tempsCuisson = brouillon.TempsCuissonMin;
        _notes = brouillon.Notes;
        _source = brouillon.Source;
        _etapes = brouillon.Etapes.Select(t => new ModeleEtape { Texte = t }).ToList();
        if (_etapes.Count == 0)
        {
            _etapes.Add(new ModeleEtape());
        }

        _lignes = PreparationImport.Preparer(brouillon.Ingredients, _rapprochement)
            .Select(i => ModeleLigne.DepuisImport(i, _unites))
            .ToList();
        _ligneEnChangement = null;
        _nomACreer = null;
        _brouillonLu = true;
    }

    private void Changer(ModeleLigne ligne)
    {
        _nomACreer = null;
        _ligneEnChangement = ligne;
    }

    private void CreerPourLigne(ModeleLigne ligne)
    {
        _ligneEnChangement = ligne;
        // Le référentiel écrit ses noms avec une majuscule : « safran » devient « Safran ».
        _nomACreer = ligne.NomLu.Length > 0 ? char.ToUpper(ligne.NomLu[0], System.Globalization.CultureInfo.GetCultureInfo("fr-CA")) + ligne.NomLu[1..] : ligne.NomLu;
    }

    private void AnnulerChangement()
    {
        _ligneEnChangement = null;
        _nomACreer = null;
    }

    /// <summary>L'ingrédient du référentiel est choisi pour une ligne importée : elle est rapprochée.</summary>
    /// <param name="uniteReference">Code de l'unité des totaux, proposée si la ligne n'en a pas encore.</param>
    private void ChoisirPourLigne(ModeleLigne ligne, int ingredientId, string nom, string? uniteReference, int? uniteReferenceId = null)
    {
        ligne.IngredientId = ingredientId;
        ligne.NomIngredient = nom;
        ligne.Statut = null;
        if (ligne.UniteId is null && !string.IsNullOrWhiteSpace(ligne.QuantiteTexte))
        {
            ligne.UniteId = uniteReferenceId ?? _unites.FirstOrDefault(u => u.Code == uniteReference)?.Id;
        }

        AnnulerChangement();
    }

    private void RetirerLigne(int position)
    {
        if (_lignes[position] == _ligneEnChangement)
        {
            AnnulerChangement();
        }

        _lignes.RemoveAt(position);
    }

    private static void Deplacer<T>(List<T> liste, int position, int decalage)
    {
        var cible = position + decalage;
        if (cible < 0 || cible >= liste.Count)
        {
            return;
        }

        (liste[position], liste[cible]) = (liste[cible], liste[position]);
    }

    private void AjouterEtiquetteSiEntree(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AjouterEtiquette();
        }
    }

    private void AjouterEtiquette()
    {
        _etiquettes = ValidationRecette.NormaliserEtiquettes(_etiquettes.Append(_nouvelleEtiquette)).ToList();
        _nouvelleEtiquette = string.Empty;
    }

    private async Task ChoisirPhotoAsync(InputFileChangeEventArgs e)
    {
        _erreurPhoto = null;
        _traitementPhoto = true;
        try
        {
            // Le navigateur ne signale pas une image illisible : il attendrait indéfiniment. On vérifie donc d'abord
            // les premiers octets du fichier d'origine.
            if (PhotoRecette.DetecterFormat(await LireDebutAsync(e.File)) is null)
            {
                throw new PhotoInvalideException("Ce fichier n'est pas une image reconnue (JPEG, PNG ou WebP).");
            }

            // Le navigateur réduit la photo et la convertit en JPEG avant l'envoi : une photo de cellulaire
            // de plusieurs Mo devient quelques centaines de Ko, sans bibliothèque d'images côté serveur.
            var reduite = await e.File
                .RequestImageFileAsync("image/jpeg", PhotoRecette.DimensionMax, PhotoRecette.DimensionMax)
                .AsTask()
                .WaitAsync(DelaiPreparation);
            var contenu = await LireAsync(reduite);
            PhotoRecette.Verifier(contenu);

            var apercu = await e.File.RequestImageFileAsync("image/jpeg", LargeurApercu, LargeurApercu).AsTask().WaitAsync(DelaiPreparation);
            _apercuNouvellePhoto = $"data:image/jpeg;base64,{Convert.ToBase64String(await LireAsync(apercu))}";
            _nouvellePhoto = contenu;
            _photoRetiree = false;
        }
        catch (PhotoInvalideException ex)
        {
            _erreurPhoto = ex.Message;
        }
        catch (IOException)
        {
            _erreurPhoto = $"La photo dépasse {PhotoRecette.TailleMaxOctets / (1024 * 1024)} Mo, même réduite.";
        }
        catch (Exception ex) when (ex is JSException or TimeoutException)
        {
            // Le navigateur n'a pas pu ouvrir le fichier comme une image (fichier abîmé, format non pris en charge).
            _erreurPhoto = "Ce fichier n'a pas pu être lu comme une image. Choisissez une photo JPEG, PNG ou WebP.";
        }
        finally
        {
            _traitementPhoto = false;
            _cleChoixPhoto = Guid.NewGuid();
        }
    }

    /// <summary>Les premiers octets du fichier, assez pour reconnaître son format, sans transférer le reste.</summary>
    private static async Task<byte[]> LireDebutAsync(IBrowserFile fichier)
    {
        var debut = new byte[16];
        await using var flux = fichier.OpenReadStream(maxAllowedSize: Math.Max(fichier.Size, 1));
        var lus = await flux.ReadAtLeastAsync(debut, debut.Length, throwOnEndOfStream: false);
        return debut[..lus];
    }

    private static async Task<byte[]> LireAsync(IBrowserFile fichier)
    {
        using var memoire = new MemoryStream();
        await using (var flux = fichier.OpenReadStream(PhotoRecette.TailleMaxOctets))
        {
            await flux.CopyToAsync(memoire);
        }

        return memoire.ToArray();
    }

    private void RetirerPhoto()
    {
        _nouvellePhoto = null;
        _apercuNouvellePhoto = null;
        _photoRetiree = true;
        _erreurPhoto = null;
    }

    private async Task EnregistrerAsync()
    {
        _erreurs = [];

        // Une étiquette tapée mais pas encore ajoutée fait partie de la recette.
        if (!string.IsNullOrWhiteSpace(_nouvelleEtiquette))
        {
            AjouterEtiquette();
        }

        var lignes = new List<LigneIngredient>();
        foreach (var ligne in _lignes)
        {
            var quantiteLue = AnalyseQuantite.EssayerLire(ligne.QuantiteTexte, out var quantite);
            if (!quantiteLue)
            {
                _erreurs.Add($"La quantité « {ligne.QuantiteTexte.Trim()} » de « {ligne.NomIngredient} » n'est pas reconnue.");
            }

            // Une quantité illisible est déjà signalée : on n'ajoute pas « unité sans quantité » pour la même ligne.
            var uniteId = quantiteLue ? ligne.UniteId : null;

            // Une ligne importée pas encore confirmée n'a pas d'ingrédient : la validation la signale avec son texte.
            lignes.Add(ligne.Statut is null
                ? new LigneIngredient(ligne.IngredientId, quantite, uniteId, ligne.Precision, ligne.EstOptionnel, ligne.NomIngredient)
                : new LigneIngredient(0, quantite, uniteId, ligne.Precision, ligne.EstOptionnel, ligne.TexteLu ?? ligne.NomIngredient));
        }

        var recette = new FicheRecette(
            Id ?? 0,
            _nom.Trim(),
            _portions,
            _tempsPreparation,
            _tempsCuisson,
            _notes,
            _source,
            lignes,
            ValidationRecette.NormaliserEtapes(_etapes.Select(e => e.Texte)),
            _etiquettes,
            PhotoConservee,
            _sourceUrl);

        _erreurs.AddRange(ValidationRecette.Valider(recette));
        if (_erreurs.Count > 0)
        {
            _focusErreurs = true;
            return;
        }

        _enCours = true;
        string? photoEcrite = null;
        try
        {
            // Le fichier est écrit avant la base : si la base échoue, on le supprime ; l'inverse laisserait
            // une recette pointant vers une photo absente.
            if (_nouvellePhoto is not null)
            {
                photoEcrite = await StockagePhotos.EnregistrerAsync(_nouvellePhoto);
                recette = recette with { PhotoChemin = photoEcrite };
            }

            if (EstNouvelle)
            {
                var auteur = (await EtatAuthentification).User.ObtenirIdUtilisateur()
                    ?? throw new InvalidOperationException("Aucun utilisateur connecté.");
                recette = recette with { Id = await DepotRecettes.AjouterAsync(recette, auteur) };
            }
            else
            {
                var modification = await DepotRecettes.ModifierAsync(recette);
                if (modification is null)
                {
                    SupprimerPhoto(photoEcrite);
                    _introuvable = true;
                    return;
                }

                // L'ancienne photo n'est supprimée qu'une fois la recette enregistrée sans elle.
                if (modification.AnciennePhotoChemin != recette.PhotoChemin)
                {
                    SupprimerPhoto(modification.AnciennePhotoChemin);
                }
            }

            Navigation.NavigateTo($"recettes/{recette.Id}");
        }
        catch (PhotoInvalideException ex)
        {
            _erreurs.Add(ex.Message);
            _focusErreurs = true;
        }
        catch
        {
            SupprimerPhoto(photoEcrite);
            throw;
        }
        finally
        {
            _enCours = false;
        }
    }

    private void SupprimerPhoto(string? nom)
    {
        if (!StockagePhotos.Supprimer(nom))
        {
            Journal.LogWarning("La photo {Photo} n'a pas pu être supprimée du dossier {Dossier}.", nom, StockagePhotos.Dossier);
        }
    }

    private sealed class ModeleLigne
    {
        public Guid Cle { get; } = Guid.NewGuid();

        public int IngredientId { get; set; }

        public string NomIngredient { get; set; } = string.Empty;

        /// <summary>Import : la ligne telle qu'elle a été lue ; <c>null</c> pour une ligne saisie ou déjà enregistrée.</summary>
        public string? TexteLu { get; init; }

        /// <summary>Import : le nom lu (« oignons »), proposé pour créer l'ingrédient.</summary>
        public string NomLu { get; init; } = string.Empty;

        /// <summary>Import : ce qu'il reste à faire pour la ligne ; <c>null</c> une fois l'ingrédient confirmé.</summary>
        public StatutRapprochement? Statut { get; set; }

        public IReadOnlyList<SuggestionIngredient> Suggestions { get; init; } = [];

        public string QuantiteTexte { get; set; } = string.Empty;

        public int? UniteId { get; set; }

        public string? Precision { get; set; }

        public bool EstOptionnel { get; set; }

        public static ModeleLigne Depuis(LigneIngredient ligne) => new()
        {
            IngredientId = ligne.IngredientId,
            NomIngredient = ligne.NomIngredient,
            QuantiteTexte = AnalyseQuantite.Ecrire(ligne.Quantite),
            UniteId = ligne.UniteId,
            Precision = ligne.Precision,
            EstOptionnel = ligne.EstOptionnel,
        };

        /// <summary>Une ligne importée : un nom identique est accepté d'office, le reste attend une confirmation.</summary>
        public static ModeleLigne DepuisImport(IngredientImporte importe, IReadOnlyList<Unite> unites)
        {
            var (lue, rapprochement) = importe;
            var propose = rapprochement.Propose;
            return new ModeleLigne
            {
                IngredientId = propose?.IngredientId ?? 0,
                NomIngredient = propose?.Nom ?? lue.Nom,
                QuantiteTexte = AnalyseQuantite.Ecrire(lue.Quantite),
                UniteId = unites.FirstOrDefault(u => u.Code == lue.CodeUnite)?.Id,
                Precision = lue.Precision,
                EstOptionnel = lue.EstOptionnel,
                TexteLu = lue.Texte,
                NomLu = lue.Nom,
                Statut = rapprochement.Statut == StatutRapprochement.Exact ? null : rapprochement.Statut,
                Suggestions = rapprochement.Suggestions,
            };
        }
    }

    private sealed class ModeleEtape
    {
        public Guid Cle { get; } = Guid.NewGuid();

        public string Texte { get; set; } = string.Empty;
    }
}
