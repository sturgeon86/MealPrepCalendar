@page "/premier-compte"
@* Accessible sans connexion, mais seulement tant qu'aucun compte n'existe.
   Rendue côté serveur seulement, comme la page de connexion, pour pouvoir poser le cookie. *@
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Repas.Domaine.Utilisateurs
@using Repas.Web.Authentification
@inject ServicePremierCompte ServicePremierCompte
@inject NavigationManager Navigation

<PageTitle>Premier compte</PageTitle>

@if (_afficher)
{
    <section class="carte-formulaire">
        <h1>Bienvenue !</h1>
        <p>Aucun compte n'existe encore. Créez le vôtre pour commencer ; vous pourrez ensuite ajouter les autres membres de la famille.</p>

        <EditForm Model="Saisie" method="post" OnValidSubmit="CreerAsync" OnInvalidSubmit="ViderMotsDePasse" FormName="premier-compte">
            <DataAnnotationsValidator />

            <div class="champ">
                <label for="nom-affiche">Nom affiché</label>
                <InputText id="nom-affiche" @bind-Value="Saisie.NomAffiche" autocomplete="name" autofocus />
                <ValidationMessage For="() => Saisie.NomAffiche" />
            </div>

            <div class="champ">
                <label for="courriel">Courriel</label>
                <InputText id="courriel" type="email" @bind-Value="Saisie.Courriel" autocomplete="username" />
                <ValidationMessage For="() => Saisie.Courriel" />
            </div>

            <div class="champ">
                <label for="mot-de-passe">Mot de passe</label>
                <InputText id="mot-de-passe" type="password" @bind-Value="Saisie.MotDePasse"
                           autocomplete="new-password" aria-describedby="aide-mot-de-passe" />
                <small id="aide-mot-de-passe" class="aide">Au moins @MotDePasse.LongueurMin caractères.</small>
                <ValidationMessage For="() => Saisie.MotDePasse" />
            </div>

            <div class="champ">
                <label for="confirmation">Confirmer le mot de passe</label>
                <InputText id="confirmation" type="password" @bind-Value="Saisie.Confirmation" autocomplete="new-password" />
                <ValidationMessage For="() => Saisie.Confirmation" />
            </div>

            <button type="submit" class="bouton-principal">Créer mon compte</button>
        </EditForm>
    </section>
}

@code {
    private bool _afficher;

    [SupplyParameterFromForm]
    private SaisiePremierCompte Saisie { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Saisie ??= new SaisiePremierCompte();

        if (!await ServicePremierCompte.EstRequisAsync())
        {
            Navigation.NavigateTo("/connexion");
            return;
        }

        _afficher = true;
    }

    // Saisie refusée : les mots de passe ne sont pas renvoyés dans la page, il faut les retaper.
    private void ViderMotsDePasse()
    {
        Saisie.MotDePasse = string.Empty;
        Saisie.Confirmation = string.Empty;
    }

    private async Task CreerAsync()
    {
        var utilisateur = await ServicePremierCompte.CreerAsync(Saisie.NomAffiche, Saisie.Courriel, Saisie.MotDePasse);
        if (utilisateur is null)
        {
            // Un compte a été créé entre-temps (ou existait déjà) : rien n'a été créé ici.
            Navigation.NavigateTo("/connexion");
            return;
        }

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            ServiceConnexion.CreerPrincipal(utilisateur));

        Navigation.NavigateTo("/");
    }

    private sealed class SaisiePremierCompte
    {
        [Required(ErrorMessage = "Le nom affiché est requis.")]
        [StringLength(Utilisateur.LongueurMaxNomAffiche, ErrorMessage = "Le nom affiché est trop long.")]
        public string NomAffiche { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le courriel est requis.")]
        [EmailAddress(ErrorMessage = "Le courriel n'est pas valide.")]
        [StringLength(Repas.Domaine.Utilisateurs.Courriel.LongueurMax, ErrorMessage = "Le courriel est trop long.")]
        public string Courriel { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le mot de passe est requis.")]
        [StringLength(
            Repas.Domaine.Utilisateurs.MotDePasse.LongueurMax,
            MinimumLength = Repas.Domaine.Utilisateurs.MotDePasse.LongueurMin,
            ErrorMessage = "Le mot de passe doit compter au moins {2} caractères.")]
        public string MotDePasse { get; set; } = string.Empty;

        [Required(ErrorMessage = "La confirmation est requise.")]
        [Compare(nameof(MotDePasse), ErrorMessage = "Les deux mots de passe ne sont pas identiques.")]
        public string Confirmation { get; set; } = string.Empty;
    }
}
