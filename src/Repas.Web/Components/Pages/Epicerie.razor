@page "/epicerie"
@implements IDisposable
@using Repas.Domaine.Calendrier
@using Repas.Domaine.Epicerie
@using Repas.Domaine.Mesures
@using Repas.Domaine.Recettes
@using Repas.Donnees
@using Repas.Domaine.Referentiel
@using Repas.Web.Authentification
@using Repas.Web.Components.Recettes
@inject DepotListeEpicerie DepotListe
@inject DepotUnites DepotUnites
@inject DepotCategories DepotCategories
@inject DiffusionListe Diffusion

<PageTitle>Épicerie</PageTitle>

<div class="entete-page">
    <h1>Épicerie</h1>
    @if (_liste is { Articles.Count: > 0 })
    {
        <div class="actions-page">
            <a class="bouton-principal bouton-compact" href="magasin">🛒 Mode magasin</a>
        </div>
    }
</div>

@if (_message is not null)
{
    <p class="@(_messageEstErreur ? "message-erreur" : "message-succes")" role="status">@_message</p>
}

@if (_charge is false)
{
    <p>Chargement…</p>
}
else if (_liste is null || !_liste.Liste.EstGeneree)
{
    <section class="carte-formulaire carte-large">
        <h2>Générer la liste</h2>
        <p class="aide">
            La liste additionne les ingrédients des recettes planifiées au calendrier pendant la période choisie.
        </p>
        @ChoixPeriode
        <button type="button" class="bouton-principal bouton-compact" disabled="@_enCours" @onclick="GenererAsync">
            @(_enCours ? "Génération…" : "Générer la liste")
        </button>
    </section>
}
else
{
    @* Fermé par défaut : en magasin, la liste passe avant. *@
    <details class="carte-formulaire carte-large regeneration">
        <summary>Regénérer la liste</summary>
        <p class="aide">
            Après un changement au calendrier : les articles des repas sont recalculés. Les articles ajoutés à la main
            et les reportés ne changent pas, et les cases cochées restent cochées, sauf si la quantité a augmenté.
        </p>
        @ChoixPeriode
        <button type="button" class="bouton-principal bouton-compact" disabled="@_enCours" @onclick="RegenererAsync">
            @(_enCours ? "Regénération…" : "Regénérer la liste")
        </button>
    </details>
}

@if (_charge)
{
    <section class="carte-formulaire carte-large ajout-article">
        @if (_aAjouter is { } choisi)
        {
            <p class="titre-creation">Ajouter « @choisi.Nom »</p>
            @if (_erreursAjout.Count > 0)
            {
                <div class="message-erreur" role="alert">
                    @foreach (var erreur in _erreursAjout)
                    {
                        <div>@erreur</div>
                    }
                </div>
            }
            <div class="grille-2">
                <div class="champ">
                    <label for="ajout-quantite">Quantité (facultative)</label>
                    <input id="ajout-quantite" @bind="_quantiteAjout" @bind:event="oninput" inputmode="decimal" autocomplete="off"
                           placeholder="Ex. : 2, 1/2" @ref="_champQuantite" />
                </div>
                <div class="champ">
                    <label for="ajout-unite">Unité</label>
                    <select id="ajout-unite" @bind="_uniteAjout">
                        @foreach (var groupe in _unites.GroupBy(u => u.TypeMesure))
                        {
                            <optgroup label="@LibelleType(groupe.Key)">
                                @foreach (var unite in groupe)
                                {
                                    <option value="@unite.Id">@unite.Code</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
            </div>
            <div class="actions-page">
                <button type="button" class="bouton-principal bouton-compact" disabled="@_enCours" @onclick="AjouterAsync">Ajouter à la liste</button>
                <button type="button" class="bouton-secondaire" @onclick="AnnulerAjout">Annuler</button>
            </div>
        }
        else if (_nomACreer is not null)
        {
            <CreationRapideIngredient NomInitial="@_nomACreer" Categories="_categories" Unites="_unites" ProposerNonAlimentaire="true"
                                      AuCreation="ChoisirCree" AuAnnuler="() => _nomACreer = null" />
        }
        else
        {
            <RechercheIngredient @key="_cleRecherche" IdChamp="ajout-article" Libelle="Ajouter un article (aliment, papier, savon…)"
                                 AuChoix="Choisir" AuCreer="nom => _nomACreer = nom" />
        }
    </section>
}

@if (_liste is { } liste && (liste.Liste.EstGeneree || liste.Articles.Count > 0))
{
    <section class="liste-epicerie">
        <div class="entete-liste">
            <h2>@liste.Liste.Nom</h2>
            @if (liste.Liste.DateGenerationUtc is { } generation)
            {
                <p class="aide">Générée le @MomentLocal(generation) · @liste.Articles.Count article@(liste.Articles.Count > 1 ? "s" : "")</p>
            }
            else
            {
                <p class="aide">Pas encore générée : ces articles resteront quand vous la générerez à partir du calendrier.</p>
            }
        </div>

        @if (liste.Articles.Count == 0)
        {
            <p class="aide">Aucun article : les recettes planifiées n'ont pas encore d'ingrédients.</p>
        }
        else
        {
            var alertes = liste.Articles.Count(a => AlertesListe.Verifier(a, _convertisseur) != RaisonEchecConversion.Aucune);
            @if (alertes > 0)
            {
                <p class="resume-alertes" role="note">
                    ⚠ @alertes ligne@(alertes > 1 ? "s" : "") n'@(alertes > 1 ? "ont" : "a") pas pu être regroupée@(alertes > 1 ? "s" : "")
                    avec le reste : complétez la fiche de l'ingrédient, puis regénérez la liste.
                </p>
            }

            @* Une section par catégorie, dans l'ordre du trajet en magasin. *@
            @foreach (var groupe in AffichageListe.GrouperParCategorie(liste.Articles))
            {
                <section class="categorie-liste" aria-labelledby="categorie-@groupe.Ordre-@groupe.Articles[0].Id">
                    <h3 id="categorie-@groupe.Ordre-@groupe.Articles[0].Id" class="titre-categorie">
                        @groupe.Categorie <span class="compte-categorie">@groupe.Articles.Count</span>
                    </h3>
                    <ul class="liste-cartes articles-liste">
                        @foreach (var article in groupe.Articles)
                        {
                            var alerte = AlertesListe.Verifier(article, _convertisseur);
                            <li @key="article.Id" class="@ClassesArticle(article, alerte)">
                                <span class="quantite-article">@AffichageListe.Quantite(article, _unitesParId)</span>
                                <div class="infos-ligne">
                                    <span class="nom-ligne">
                                        @article.NomIngredient
                                        @if (article.NbRecettes > 1)
                                        {
                                            <span class="details-ligne"> (@article.NbRecettes recettes)</span>
                                        }
                                        @if (article.EstManuel)
                                        {
                                            <span class="pastille">Ajout manuel</span>
                                        }
                                        @if (article.EstReporte)
                                        {
                                            <span class="pastille">Reporté</span>
                                        }
                                        @if (article.EstCoche)
                                        {
                                            <span class="visuellement-cache"> (coché)</span>
                                        }
                                    </span>
                                    @if (alerte != RaisonEchecConversion.Aucune)
                                    {
                                        <span class="texte-alerte">
                                            ⚠ @AlertesListe.Decrire(alerte)
                                            <a href="ingredients/@article.IngredientId">Compléter la fiche</a>
                                        </span>
                                    }
                                </div>
                                @if (article.PeutEtreRetire)
                                {
                                    <button type="button" class="bouton-icone bouton-retirer-article" title="Retirer de la liste"
                                            aria-label="Retirer @article.NomIngredient de la liste" @onclick="() => RetirerAsync(article)">✕</button>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    </section>
}

@if (_liste is { Articles.Count: > 0 } aTerminer)
{
    var nonAchetes = Terminaison.NonAchetes(aTerminer.Articles);
    var nbAReporter = nonAchetes.Count(a => !_nonReportes.Contains(a.Id));
    @* Après l'épicerie : la liste se termine, et ce qui n'a pas été acheté peut passer à la suivante. *@
    <details id="terminer" class="carte-formulaire carte-large terminaison" open="@TerminerOuvert">
        <summary>Terminer la liste</summary>
        @if (nonAchetes.Count == 0)
        {
            <p class="aide">Tous les articles sont cochés. La liste terminée est gardée ; la prochaine commencera vide.</p>
            <button type="button" class="bouton-principal bouton-compact" disabled="@_enCours" @onclick="TerminerAsync">Terminer la liste</button>
        }
        else
        {
            <p class="aide">
                @nonAchetes.Count article@(nonAchetes.Count > 1 ? "s n'ont" : " n'a") pas été acheté@(nonAchetes.Count > 1 ? "s" : "").
                Gardez cochés ceux à reporter sur la prochaine liste : ils y seront marqués « Reporté » et resteront à la regénération.
            </p>
            <div class="actions-page choix-reports">
                <button type="button" class="bouton-lien-texte" @onclick="() => _nonReportes.Clear()">Tout reporter</button>
                <button type="button" class="bouton-lien-texte" @onclick="() => _nonReportes.UnionWith(nonAchetes.Select(a => a.Id))">Ne rien reporter</button>
            </div>
            <ul class="liste-reports">
                @foreach (var article in nonAchetes)
                {
                    <li @key="article.Id">
                        <label class="champ-case">
                            <input type="checkbox" checked="@(!_nonReportes.Contains(article.Id))" @onchange="() => BasculerReport(article.Id)" />
                            <span>
                                @article.NomIngredient
                                <span class="details-ligne">@AffichageListe.Quantite(article, _unitesParId)</span>
                            </span>
                        </label>
                    </li>
                }
            </ul>
            <button type="button" class="bouton-principal bouton-compact" disabled="@_enCours" @onclick="TerminerAsync">
                @(nbAReporter == 0 ? "Terminer sans rien reporter" : $"Terminer et reporter {nbAReporter} article{(nbAReporter > 1 ? "s" : "")}")
            </button>
        }
    </details>
}

@code {
    private bool _charge;
    private ListeAvecArticles? _liste;
    private ConvertisseurUnites _convertisseur = new([]);
    private Dictionary<int, Unite> _unitesParId = [];
    private Semaine _semaineCourante;
    private DateOnly _debut;
    private DateOnly _fin;
    private bool _enCours;
    private string? _message;
    private bool _messageEstErreur;

    // Ajout manuel : l'article choisi dans le référentiel, puis sa quantité facultative.
    private List<Unite> _unites = [];
    private List<Categorie> _categories = [];
    private (int Id, string Nom)? _aAjouter;
    private string _quantiteAjout = string.Empty;
    private int _uniteAjout;
    private string? _nomACreer;
    private List<string> _erreursAjout = [];
    private ElementReference _champQuantite;
    private bool _focusQuantite;
    private Guid _cleRecherche = Guid.NewGuid();

    // Temps réel : cet écran annonce ses changements et reçoit ceux des autres.
    private readonly Guid _ecran = Guid.NewGuid();
    private IDisposable? _abonnement;

    // Terminer : par défaut, tous les articles non achetés sont reportés ; on retient ceux qu'on a décochés.
    private readonly HashSet<int> _nonReportes = [];

    /// <summary>Ouvre le bloc « Terminer la liste » à l'arrivée, depuis le mode magasin : <c>?terminer=1</c>.</summary>
    [SupplyParameterFromQuery(Name = "terminer")]
    public string? Terminer { get; set; }

    private bool TerminerOuvert => Terminer is not null;

    [CascadingParameter]
    private Task<AuthenticationState> EtatAuthentification { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // L'heure du serveur suit le fuseau de la famille (variable TZ du conteneur).
        _semaineCourante = Semaine.Contenant(DateOnly.FromDateTime(DateTime.Now));
        ChoisirSemaine(_semaineCourante);
        _unites = await DepotUnites.ListerAsync();
        _categories = await DepotCategories.ListerAsync();
        _convertisseur = new ConvertisseurUnites(_unites);
        _unitesParId = _unites.ToDictionary(u => u.Id);
        _abonnement = Diffusion.Abonner(SurChangementAsync);
        await ChargerAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusQuantite)
        {
            _focusQuantite = false;
            await _champQuantite.FocusAsync();
        }
    }

    private static string LibelleType(TypeMesure type) => type switch
    {
        TypeMesure.Poids => "Poids",
        TypeMesure.Volume => "Volume",
        _ => "À la pièce",
    };

    private void Choisir(ResumeIngredient ingredient) =>
        Preparer(ingredient.Id, ingredient.Nom, _unites.FirstOrDefault(u => u.Code == ingredient.UniteReference)?.Id);

    private void ChoisirCree(CreationRapideIngredient.IngredientCree cree)
    {
        _nomACreer = null;
        Preparer(cree.Id, cree.Nom, cree.UniteReferenceId);
    }

    /// <summary>L'article est choisi : on demande sa quantité, dans l'unité de ses totaux par défaut.</summary>
    private void Preparer(int id, string nom, int? uniteReferenceId)
    {
        _aAjouter = (id, nom);
        _quantiteAjout = string.Empty;
        _uniteAjout = uniteReferenceId ?? _unites.FirstOrDefault()?.Id ?? 0;
        _erreursAjout = [];
        _focusQuantite = true;
    }

    private void AnnulerAjout()
    {
        _aAjouter = null;
        _erreursAjout = [];
        _cleRecherche = Guid.NewGuid();
    }

    private async Task AjouterAsync()
    {
        if (_aAjouter is not { } choisi)
        {
            return;
        }

        _message = null;
        if (!AnalyseQuantite.EssayerLire(_quantiteAjout, out var quantite))
        {
            _erreursAjout = [$"La quantité « {_quantiteAjout.Trim()} » n'est pas reconnue."];
            return;
        }

        // Sans quantité, l'unité ne compte pas : « Papier de toilette », tout simplement.
        var ajout = new AjoutManuel(choisi.Id, quantite, quantite is null ? null : _uniteAjout);
        _erreursAjout = ajout.Valider().ToList();
        if (_erreursAjout.Count > 0)
        {
            return;
        }

        _enCours = true;
        try
        {
            var auteur = (await EtatAuthentification).User.ObtenirIdUtilisateur()
                ?? throw new InvalidOperationException("Aucun utilisateur connecté.");
            var resultat = await DepotListe.AjouterManuelAsync(ajout, auteur);
            Afficher(
                resultat.Additionne ? $"« {choisi.Nom} » était déjà sur la liste : la quantité a été ajoutée." : $"« {choisi.Nom} » ajouté à la liste.",
                erreur: false);
            AnnulerAjout();
            await ChargerEtAnnoncerAsync();
        }
        catch (AjoutManuelRefuseException ex)
        {
            _erreursAjout = [ex.Message];
        }
        finally
        {
            _enCours = false;
        }
    }

    private async Task RetirerAsync(ArticleListe article)
    {
        _message = null;
        if (await DepotListe.RetirerAsync(article.Id))
        {
            Afficher($"« {article.NomIngredient} » retiré de la liste.", erreur: false);
        }
        else
        {
            Afficher($"« {article.NomIngredient} » n'était plus sur la liste.", erreur: true);
        }

        await ChargerEtAnnoncerAsync();
    }

    /// <param name="reprendrePeriode">
    /// Faux quand c'est quelqu'un d'autre qui a changé la liste : on ne touche pas aux dates en cours de saisie.
    /// </param>
    private async Task ChargerAsync(bool reprendrePeriode = true)
    {
        _liste = await DepotListe.TrouverActiveAsync();
        _charge = true;

        // Une liste générée propose sa propre période pour la regénérer.
        if (reprendrePeriode && _liste?.Liste is { DateDebut: { } debut, DateFin: { } fin })
        {
            _debut = debut;
            _fin = fin;
        }
    }

    /// <summary>Relit la liste après un changement fait ici, et l'annonce aux autres écrans ouverts.</summary>
    private async Task ChargerEtAnnoncerAsync()
    {
        await ChargerAsync();
        var auteur = (await EtatAuthentification).User.Identity?.Name;
        _ = Diffusion.PublierAsync(ChangementListe.Contenu(_ecran, auteur));
    }

    /// <summary>Un autre écran a changé la liste (ajout, coche en magasin…) : la page se met à jour d'elle-même.</summary>
    private Task SurChangementAsync(ChangementListe changement) =>
        changement.Origine == _ecran
            ? Task.CompletedTask
            : InvokeAsync(async () =>
            {
                await ChargerAsync(reprendrePeriode: false);
                StateHasChanged();
            });

    public void Dispose() => _abonnement?.Dispose();

    private void BasculerReport(int articleId)
    {
        if (!_nonReportes.Remove(articleId))
        {
            _nonReportes.Add(articleId);
        }
    }

    private async Task TerminerAsync()
    {
        if (_liste is not { } liste)
        {
            return;
        }

        _message = null;
        _enCours = true;
        try
        {
            var aReporter = Terminaison.NonAchetes(liste.Articles).Select(a => a.Id).Where(id => !_nonReportes.Contains(id)).ToList();
            var utilisateur = (await EtatAuthentification).User.ObtenirIdUtilisateur()
                ?? throw new InvalidOperationException("Aucun utilisateur connecté.");
            var resultat = await DepotListe.TerminerAsync(liste.Liste.Id, aReporter, utilisateur);

            if (resultat.Statut == StatutTerminaison.ListeNonActive)
            {
                Afficher("Cette liste avait déjà été terminée, peut-être depuis un autre appareil. Voici la liste active.", erreur: true);
            }
            else
            {
                Afficher(
                    resultat.NbReportes == 0
                        ? "Liste terminée. La prochaine commencera vide."
                        : $"Liste terminée. {resultat.NbReportes} article{(resultat.NbReportes > 1 ? "s ont été reportés" : " a été reporté")} sur la prochaine liste.",
                    erreur: false);
            }

            _nonReportes.Clear();
            await ChargerEtAnnoncerAsync();
        }
        finally
        {
            _enCours = false;
        }
    }

    /// <summary>Raccourcis de semaine et dates, communs à la génération et à la regénération.</summary>
    private RenderFragment ChoixPeriode => __builder =>
    {
        <div class="suggestions-rapides">
            <button type="button" class="bouton-secondaire bouton-mini" @onclick="() => ChoisirSemaine(_semaineCourante)">
                Cette semaine (@_semaineCourante.Libelle)
            </button>
            <button type="button" class="bouton-secondaire bouton-mini" @onclick="() => ChoisirSemaine(_semaineCourante.Suivante())">
                Semaine prochaine (@_semaineCourante.Suivante().Libelle)
            </button>
        </div>
        <div class="grille-2">
            <div class="champ">
                <label for="debut">Du</label>
                <input id="debut" type="date" @bind="_debut" />
            </div>
            <div class="champ">
                <label for="fin">Au</label>
                <input id="fin" type="date" @bind="_fin" />
            </div>
        </div>
    };

    private async Task RegenererAsync()
    {
        _message = null;
        if (_fin < _debut)
        {
            Afficher("La date de fin doit suivre la date de début.", erreur: true);
            return;
        }

        _enCours = true;
        try
        {
            var resultat = await DepotListe.RegenererAsync(_debut, _fin);
            if (resultat.Statut == StatutRegeneration.AucuneListeGeneree)
            {
                Afficher("La liste n'existe plus ou n'a pas encore été générée : générez-la.", erreur: true);
            }
            else
            {
                Afficher(ResumerRegeneration(resultat), erreur: false);
            }

            await ChargerEtAnnoncerAsync();
        }
        finally
        {
            _enCours = false;
        }
    }

    private static string ResumerRegeneration(ResultatRegeneration r)
    {
        static string Nombre(int n, string singulier, string pluriel) => $"{n} {(n > 1 ? pluriel : singulier)}";

        var changements = new List<string>();
        if (r.NbAjoutes > 0)
        {
            changements.Add(Nombre(r.NbAjoutes, "article ajouté", "articles ajoutés"));
        }

        if (r.NbRetires > 0)
        {
            changements.Add(Nombre(r.NbRetires, "article retiré", "articles retirés"));
        }

        if (r.NbMisAJour > 0)
        {
            changements.Add(Nombre(r.NbMisAJour, "article recalculé", "articles recalculés"));
        }

        var texte = $"Liste regénérée à partir de {Nombre(r.NbRepas, "repas", "repas")} : "
            + (changements.Count == 0 ? "aucun article des repas." : string.Join(", ", changements) + ".");
        if (r.NbDecoches > 0)
        {
            texte += $" {Nombre(r.NbDecoches, "article a été décoché", "articles ont été décochés")} parce qu'il en faut davantage.";
        }

        if (r.NbConserves > 0)
        {
            texte += $" {Nombre(r.NbConserves, "article manuel ou reporté est conservé", "articles manuels ou reportés sont conservés")}.";
        }

        return texte;
    }

    private void ChoisirSemaine(Semaine semaine)
    {
        _debut = semaine.Debut;
        _fin = semaine.Fin;
    }

    private async Task GenererAsync()
    {
        _message = null;
        if (_fin < _debut)
        {
            Afficher("La date de fin doit suivre la date de début.", erreur: true);
            return;
        }

        _enCours = true;
        try
        {
            var auteur = (await EtatAuthentification).User.ObtenirIdUtilisateur()
                ?? throw new InvalidOperationException("Aucun utilisateur connecté.");
            var resultat = await DepotListe.GenererAsync(_debut, _fin, auteur);
            switch (resultat.Statut)
            {
                case StatutGeneration.Generee:
                    Afficher(
                        $"Liste générée : {resultat.NbArticles} article{(resultat.NbArticles > 1 ? "s" : "")} " +
                        $"à partir de {resultat.NbRepas} repas.",
                        erreur: false);
                    break;
                case StatutGeneration.AucunRepas:
                    Afficher(
                        $"Aucun repas avec recette au calendrier du {Semaine.LibellePeriode(_debut, _fin)}. Planifiez des repas, puis générez la liste.",
                        erreur: true);
                    break;
                default:
                    Afficher("Une liste a déjà été générée, peut-être depuis un autre appareil. La voici.", erreur: false);
                    break;
            }

            await ChargerEtAnnoncerAsync();
        }
        finally
        {
            _enCours = false;
        }
    }

    private void Afficher(string message, bool erreur)
    {
        _message = message;
        _messageEstErreur = erreur;
    }

    private static string? ClassesArticle(ArticleListe article, RaisonEchecConversion alerte)
    {
        var classes = new List<string>();
        if (alerte != RaisonEchecConversion.Aucune)
        {
            classes.Add("article-alerte");
        }

        if (article.EstCoche)
        {
            classes.Add("article-coche");
        }

        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    private static string MomentLocal(DateTime utc)
    {
        var local = TimeZoneInfo.ConvertTimeFromUtc(utc, TimeZoneInfo.Local);
        var culture = System.Globalization.CultureInfo.GetCultureInfo("fr-CA");
        // « 16 nov. à 7 h 05 », comme on écrit l'heure au Québec.
        return $"{local.ToString("d MMM", culture)} à {local.ToString("H' h 'mm", culture)}";
    }
}
