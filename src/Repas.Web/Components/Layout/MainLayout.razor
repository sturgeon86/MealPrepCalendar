@inherits LayoutComponentBase

<header class="entete">
    <a class="titre-app" href="">Planificateur de repas</a>
    <AuthorizeView>
        <Authorized>
            <div class="compte">
                <a class="lien-entete" href="calendrier">Calendrier</a>
                <a class="lien-entete" href="recettes">Recettes</a>
                <a class="lien-entete" href="ingredients">Ingrédients</a>
                <a class="lien-entete" href="comptes">Comptes</a>
                <a class="lien-entete nom-utilisateur" href="mon-compte" title="Mon compte">@context.User.Identity?.Name</a>
                @* Formulaire HTTP ordinaire : le cookie est retiré par le serveur, pas par le circuit interactif. *@
                <form method="post" action="deconnexion">
                    <AntiforgeryToken />
                    <button type="submit" class="bouton-lien">Se déconnecter</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main class="contenu">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue s'est produite.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>
